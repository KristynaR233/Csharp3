﻿@using Microsoft.AspNetCore.Mvc.Routing
@using ToDoList.Frontend.Models;
@using ToDoList.Frontend.Clients;
@page "/"

@inject IToDoItemsClient toDoItemsClient;
@inject NavigationManager NavigationManager

<div>
    <h2>ToDo items dashboard</h2>
    <table class="table table-hover">
        <thead class="table-primary">
            <tr>
                <th><button @onclick="OrderByID">Order by ID</button></th>
                <th><button @onclick="OrderByName">Order by Name</button></th>
                <th>Description</th>
                <th>Dokončeno</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ToDoItemView item in testData)
            {
                <tr class="table-secondary">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Finished" : "Unfinished")</td>
                    <td>
                        <button class="btn btn-success" @onclick="() => EditItem(item)">Edit</button>
                        <button class="btn btn-danger" @onclick="() => DeleteItem(item)">Delete</button>
                        <button class="btn btn-warning" @onclick="() => ToggleCompleted(item)">@(item.IsCompleted ? "Unifinished" : "Finished")</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


@code {
    public List<ToDoItemView> testData = new List<ToDoItemView>();


    public async Task OrderByID()
    {
        testData = testData.OrderBy(item => item.Id).ToList();


    }
    public async Task OrderByName()
    {
        testData = testData.OrderBy(item => item.Name).ToList();

    }
    public void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo($"editToDoItem/{toDoItem.Id}");

    }

    public async Task DeleteItem(ToDoItemView item)
    {
        await toDoItemsClient.DeleteItemAsync(item);
        testData.Remove(item);
    }

    public async Task ToggleCompleted(ToDoItemView toDoItem)
    {
        toDoItem.IsCompleted = !toDoItem.IsCompleted;
        await toDoItemsClient.UpdateItemAsync(toDoItem);
    }
    protected override async Task OnInitializedAsync()
    {
        testData = await toDoItemsClient.ReadItemsAsync();

    }


}
