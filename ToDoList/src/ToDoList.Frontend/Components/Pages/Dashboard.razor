﻿@using Microsoft.AspNetCore.Mvc.Routing
@using ToDoList.Frontend.Models;
@using ToDoList.Frontend.Clients;

@page "/"

@inject IToDoItemsClient toDoItemsClient;
@inject NavigationManager NavigationManager

<div>
    <h2>ToDo items dashboard</h2>
    <table class="table table-hover">
        <thead class="table-primary">
            <tr>
                <th><button @onclick="OrderByID">Order by ID</button></th>
                <th><button @onclick="OrderByName">Order by Name</button></th>
                <th>Description</th>
                <th>Dokončeno</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ToDoItemView item in testData)
            {
                <tr class="table-secondary">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Dokonceny" : "Nedokonceny")</td>
                    <td><button class="btn btn-success" @onclick="() => EditItem(item)">Edit</button>
                    <button class="btn btn-danger" @onclick="() => DeleteItem(item)">Delete</button>
                    <button class="btn btn-warning" @onclick="() => ToggleCompleted(item)">@(item.IsCompleted ? "Označit jako dokonceny" : "Označit jako nedokonceny")</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


@code {
public List<ToDoItemView> testData = new List<ToDoItemView>()
{
    new ToDoItemView { Id = 1, Name = "Napis ukol", Description = "domaci ukol", IsCompleted = false },
    new ToDoItemView { Id = 2, Name = "Upect cukrovi", Description = "zadelej testa", IsCompleted = false },
    new ToDoItemView { Id = 3, Name = "Zavolej Sarce", Description = "domluvit sraz", IsCompleted = false },
    new ToDoItemView { Id = 4, Name = "Nakup", Description = "objednej Rohlik", IsCompleted = false },
    new ToDoItemView { Id = 5, Name = "Nove zimni boty", Description = "zimni boty", IsCompleted = false }
};
 protected override async Task OnInitializedAsync()
    {
        testData = await toDoItemsClient.ReadItemsAsync();

    }


    private void OrderByID()
    {
        testData = testData.OrderBy(item => item.Id).ToList();


    }
    private void OrderByName()
    {
        testData = testData.OrderBy(item => item.Name).ToList();

    }
     private void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo(uri: $"editToDoItem/{toDoItem.Id}");

    }

    private async Task DeleteItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo(uri: $"editToDoItem/{toDoItem.Id}");
    }

    private async Task ToggleCompleted(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo(uri: $"editToDoItem/{toDoItem.Id}");
    }


}
