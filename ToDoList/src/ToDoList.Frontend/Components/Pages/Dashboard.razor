@using ToDoList.Frontend.Models;
@using ToDoList.Frontend.Clients;

@inject IToDoItemsClient toDoItemsClient;

<div>
    <h2>ToDo items dashboard</h2>
    <table>
        <thead class: colore: green>
            <tr>
                <th>ID</th>
                <th>Název</th>
                <th>Popis</th>
                <th>Dokončeno</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in testData)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Dokonceny" : "Nedokonceny")</td>
                    <td><button class="btn btn-success" @onclick="EditItem"</td>
                </tr>
            }
        </tbody>
    </table>
    <button @onclick="OrderByID">Order by ID</button>
    <button @onclick="OrderByName">Order by Name</button>
</div>
@code {

    private List<ToDoItemsView> testData = new List<ToDoItemsView>();


    private void OrderByID()
    {
        testData = testData.OrderBy(item => item.Id).ToList();


    }
    private void OrderByName()
    {
        testData = testData.OrderBy(item => item.Name).ToList();

    }

    protected override async Task OnInitializedAsync()
    {
        testData = await toDoItemsClient.ReadItemsAsync();

    }
}
